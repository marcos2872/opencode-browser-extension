{
  "name": "opencode-browser-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:ui && npm run build:bg && npm run build:content && npm run build:offscreen",
    "build:ui": "vite build --config vite.config.ts",
    "build:bg": "vite build --config vite.background.config.ts",
    "build:content": "vite build --config vite.content.config.ts",
    "build:offscreen": "vite build --config vite.offscreen.config.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build",
    "install:plugin": "mkdir -p ~/.config/opencode/plugins && rm -f ~/.config/opencode/plugins/opencode-browser.ts && cp plugin/browser-relay.ts ~/.config/opencode/plugins/browser-relay.ts",
    "package": "npm run build && cd dist && zip -r ../opencode-browser-extension.zip .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.1.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
